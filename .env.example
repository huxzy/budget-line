# Vapi web SDK. The app renders and browses without these; voice shows "unavailable".
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=

# Optional: use a saved Vapi assistant instead of the inline config in lib/assistant.ts.
NEXT_PUBLIC_VAPI_ASSISTANT_EN=
NEXT_PUBLIC_VAPI_ASSISTANT_HA=

# Public URL of this deployment. Vapi's servers call the /api tools here, so
# voice lookups need a reachable URL (Vercel sets VERCEL_URL automatically).
NEXT_PUBLIC_APP_URL=
